// #include <layout_shift.dtsi>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "layout_shift.dtsi"

/ {
    behaviors {
        // Keep the original key_press behavior for ZMK core components

        original_key_press: original_key_press {
            compatible = "zmk,behavior-key-press";
            #binding-cells = <1>;
            label = "KEY_PRESS";
        };

        // Override the existing &kp behavior to use our custom implementation

        kp: key_press {
            compatible = "zmk,behavior-layout-shift-key-press";
            #binding-cells = <1>;
            label = "LAYOUT_SHIFT_KEY_PRESS";
        };
    };
};

#define DEF 0
#define FUNC 1
#define NUM 2
#define SNIPE 3
#define BT 4
#define SCROLL 5
#define SSNIPE 6

/ {
    combos {
        compatible = "zmk,combos";
        
        COMBO_LANG1 {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <1 2>;
        };

        COMBO_LANG2 {
            bindings = <&kp LANG2>;
            key-positions = <2 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Def";
            bindings = <
&kp ESCAPE  &kp Q         &kp W                &kp E          &kp R        &kp T                        &lt SNIPE Y    &kp U          &kp I              &kp O      &kp P           &kp BACKSPACE
&lt BT TAB  &kp A         &kp S                &kp D          &kp F        &kp G                        &kp H          &kp J          &kp K              &kp L      &kp MINUS       &kp ENTER
&kp LSHFT   &mt LSHIFT Z  &kp X                &kp C          &kp V        &kp B                        &kp N          &kp M          &kp COMMA          &lt 5 DOT  &lt 6 UP_ARROW
&kp LCTRL   &kp LALT      &mt LGUI LANGUAGE_2                 &lt 5 SPACE  &lt FUNC LANGUAGE_1          &kp BACKSPACE  &lt NUM ENTER  &lt NUM LG(SPACE)  &kp LEFT   &kp DOWN        &kp RIGHT
&kp HOME    &kp PAGE_UP   &kp SPACE            &kp PAGE_DOWN  &kp END  *                                 &mkp MB1       &mkp MB3       &mkp MB2
&mo SCROLL  &mo SSNIPE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        function_layer {
            label = "Fnc";
            bindings = <
&kp LG(SEMICOLON)  &trans  &kp F2     &kp LC(LA(LEFT))  &kp LC(LA(RIGHT))  &kp F4                    &kp F1            &kp F10            &trans         &trans                &trans          &trans
&trans             &trans  &trans     &trans            &trans             &kp SEMICOLON             &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans         &trans                &trans          &trans
&trans             &trans  &trans     &trans            &trans             &kp BACKSLASH             &kp LESS_THAN     &kp GREATER_THAN   &kp LG(LS(D))  &kp LG(LS(NUMBER_4))  &kp LG(LS(N5))
&trans             &trans  &kp LALT                     &kp EQUAL          &lt 1 LANGUAGE_1          &kp DELETE        &kp ENTER          &kp BKSP       &trans                &trans          &trans
&kp LEFT           &kp UP  &kp SPACE  &kp DOWN          &kp RIGHT                                    &trans            &trans             &trans
&trans             &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            label = "Num";
            bindings = <
&trans           &kp TAB           &kp N7     &kp N8        &kp N9         &kp MINUS              &kp LC(LEFT)           &kp LC(RIGHT)  &kp LC(UP_ARROW)  &kp LC(DOWN)  &kp LC(LS(LG(Z)))  &trans
&trans           &kp N0            &kp N4     &kp N5        &kp N6         &kp COLON              &kp LG(RIGHT_BRACKET)  &kp AT_SIGN    &kp UP_ARROW      &kp GRAVE     &trans             &trans
&mt LSHFT SPACE  &mt LSHIFT SLASH  &kp N1     &kp N2        &kp N3         &kp BSLH               &kp LG(LEFT_BRACKET)   &kp LEFT       &kp DOWN          &kp RIGHT     &trans
&trans           &kp LSHFT         &kp LALT                 &kp LG(LC(R))  &kp LC(LS(S))          &trans                 &lt 2 ENTER    &trans            &trans        &trans             &trans
&kp LC(LEFT)     &kp LC(UP)        &kp SPACE  &kp LC(DOWN)  &kp LC(RIGHT)                         &trans                 &trans         &trans
&trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        snipe_layer {
            label = "Snipe";
            bindings = <
&trans    &trans  &trans     &trans    &trans     &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans     &trans    &trans     &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans     &trans    &trans     &trans          &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans               &trans     &trans          &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT  &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT                  &trans  &trans  &trans
&trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        bt_layer {
            label = "BT";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4          &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans                &trans          &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans                &trans          &trans  &trans  &trans  &trans
&trans      &trans        &trans                      &trans        &trans                &trans          &trans  &trans  &trans  &trans  &trans
&kp LEFT    &kp UP        &kp SPACE     &kp DOWN      &kp RIGHT                           &trans          &trans  &trans
&trans      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans    &kp ESC          &kp F2             &kp LC(LA(LEFT))  &kp LC(LA(RIGHT))     &kp PIPE                       &kp LA(LC(D))  &kp LA(LC(E))  &kp LA(LC(F))  &kp LA(LC(T))     &kp LA(LC(G))      &trans
&trans    &kp TAB          &kp DOUBLE_QUOTES  &kp AMPERSAND     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS          &kp LBKT       &kp RBKT       &kp APOS       &kp LG(LS(DOWN))  &kp LC(LA(ENTER))  &trans
&trans    &mt LSHIFT HASH  &kp PLUS           &kp EXCLAMATION   &kp QUESTION          &kp TILDE                      &kp LG(A)      &kp LG(C)      &kp LG(V)      &kp LC(Q)         &kp LG(PLUS)
&trans    &trans           &kp EQUAL                            &lt 5 SPACE           &trans                         &kp DELETE     &trans         &trans         &kp LS(LC(TAB))   &kp LG(MINUS)      &kp LC(TAB)
&kp LEFT  &kp UP           &kp SPACE          &kp DOWN          &kp RIGHT                                            &trans         &trans         &trans
&trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        SSNIPE_layer {
            label = "SSNIPE";
            bindings = <
&trans    &trans  &trans     &trans    &kp LG(LA(MINUS))  &kp LG(LA(LS(EQUAL)))          &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans     &trans    &kp LS(F11)        &kp LA(LS(S))                  &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans     &trans    &trans             &trans                         &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans               &trans             &trans                         &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT  &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT                                         &trans  &trans  &trans
&trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
